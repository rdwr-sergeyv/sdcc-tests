# Template for docker/legacy-portal/.env -- copy it to `.env` and uncomment ONE mongo option.
# Secrets are intentionally blank here.
#
SDCC_REPO_PATH=../../../sdcc
SDCC_PORTAL_REPO_PATH=../../../sdcc-portal
LEGACY_PORTAL_PORT=8000
LEGACY_PORTAL_MONGO_IMAGE=mongo:8.2
LEGACY_PORTAL_MONGO_PORT=27018
LEGACY_PORTAL_MONGO_DB_PATH=../../.tmp/legacy-portal-mongo-db
# ---------------------------------------------------------------- which mongod the app talks to
# TWO OPTIONS, and only one may be uncommented. Both are kept here on purpose: the choice is not
# obvious from the outside, and picking the wrong one produces failures that look like product bugs.
#
# OPTION A -- self-contained compose stack (the original default)
#   The portal and backends use the `mongo` service in this compose file, published on the host as
#   :27018. Nothing outside the stack is required, so this is the option to use on a fresh machine.
#   The helpers must then read the SAME container, which is the default they already assume.
#SDCC_MONGO_HOST=mongo
#LEGACY_PORTAL_MONGO_CONTAINER=legacy-portal-mongo-1
#
# OPTION B -- the on-host copy shared with the unified services  `[2026-09-01]`
#   The portal and backends read 10.20.4.20:27017, the mongod that also holds `syst`, `policyeditor`
#   and `consoles`, so legacy and unified sit on one server. This is what the pre-release feature
#   integration tests want.
#
#   REQUIRES `sdcc` to exist on :27017. It is not there on a fresh machine -- create it with
#   `tools/lab_trim_sdcc_copy.py` and `tools/lab_port_fixtures.py` in the cddos-legacy repo
#   (mongodump from :27018 excluding telemetry, then trim to one account and port its fixtures).
#
#   LEGACY_PORTAL_MONGO_CONTAINER matters as much as the host. dp-isolate-helpers.cjs runs
#   `docker exec <container> mongosh <db>` with NO host argument, so it reads whichever mongod lives
#   inside that container. Leave it on legacy-portal-mongo-1 here and every helper compares against
#   :27018 -- a database the portal no longer writes to. `blockerDB` is the container serving :27017
#   (mongo:5.0.10, network_mode host); the name is misleading, it holds far more than `blocker`.
#SDCC_MONGO_HOST=10.20.4.20
#LEGACY_PORTAL_MONGO_CONTAINER=blockerDB
#
# Common to both options: the port is the one the chosen server listens on (both happen to be 27017 --
# :27018 is the HOST publication of the compose mongo, its container still listens on 27017).
SDCC_MONGO_PORT=27017
SDCC_MONGO_DB=sdcc
SDCC_PORTAL_PUBLIC_URL=http://localhost:8000
# The stack: mongo + portal + the two supervisord backend nodes. Leave it alone.
DP_ISOLATE_COMPOSE_PROFILE=lab

# build        = build the commands, contact no device
# provisioning = build AND execute them on the devices
# Governs automatic diversions only; a manual action takes its type from the caret in the UI.
SDCC_TASK_TYPE=build
# Which supervisord config each backend node runs -- a FILE NAME under supervisor/, not a backend
# name (passing `docker` here makes supervisord look for docker.conf and crash-loop the container).
# Both configs declare the same 45/19 programs; `minimal-*` autostarts only the core ones -- 2 in
# hybrid, 1 in monitor -- which is all the test suites need. `full-*` starts every poller and
# aggregator, which idles the backends at ~1% CPU while pinning Mongo at ~350%; minimal leaves it
# at ~20%.
SDCC_HYBRID_PROFILE=minimal-hybrid
SDCC_MONITOR_PROFILE=minimal-monitor

