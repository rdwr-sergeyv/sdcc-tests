SDCC_REPO_PATH=../../../sdcc
SDCC_PORTAL_REPO_PATH=../../../sdcc-portal
LEGACY_PORTAL_PORT=8000
LEGACY_PORTAL_MONGO_IMAGE=mongo:8.2
LEGACY_PORTAL_MONGO_PORT=27018
LEGACY_PORTAL_MONGO_DB_PATH=../../.tmp/legacy-portal-mongo-db
SDCC_MONGO_HOST=mongo
SDCC_MONGO_PORT=27017
SDCC_MONGO_DB=sdcc
SDCC_PORTAL_PUBLIC_URL=http://localhost:8000
# One service scope (minimal | full | lab) plus one task type (execute | build-only).
# `lab,build-only` is what the lab runs: the two supervisord backend nodes, mongo, and the
# build-mode portal. Keep this in step with the running stack -- a value that does not describe
# it is how a whole-stack target ends up deleting services as orphans.
DP_ISOLATE_COMPOSE_PROFILE=lab,build-only
SDCC_HYBRID_PROFILE=full-hybrid

